# Required Telegram Credentials
API_ID=1234567
API_HASH=your_api_hash_here
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# MongoDB Connection String (from https://cloud.mongodb.com)
MONGO_DB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Telegram User ID of Owner
OWNER_ID=123456789

# Telegram Group ID for Logging (Must be negative integer, e.g. -100xxxxxxxxxx)
LOGGER_ID=-1001234567890

# Pyrogram v2 String Session for Assistant Account
STRING_SESSION=your_pyrogram_string_session_here

# Optional Configurations
BOT_NAME=CaseyMusic
BOT_USERNAME=CaseyMusicBot
OWNER_USERNAME=your_username
PORT=8080
SUPPORT_CHAT=https://t.me/your_support_chat
SUPPORT_CHANNEL=https://t.me/your_support_channel
START_IMG_URL=https://telegra.ph/file/982b01ba53c3d69b0d0ce.jpg
